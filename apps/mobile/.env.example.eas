# =============================================================================
# MOBILE / EAS — public values bundled into the APK/IPA
# =============================================================================
# Copy this file to .env for local native development, then fill in the values.
# Every EXPO_PUBLIC_* value is readable by anyone with the app. Never put a
# secret in this file.

# Firebase web config — public by design; Firestore access is protected by
# Firebase Auth and firestore.rules, not by hiding these identifiers.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Google sign-in OAuth client IDs. These are public identifiers, not secrets.
# Web: Firebase console -> Authentication -> Sign-in method -> Google ->
#      Web SDK configuration.
# iOS: the OAuth client registered for the bundle identifier being built. It
#      also becomes the reversed URL scheme in app.config.js.
# Android needs no ID here — it is matched by package name + the SHA-1
# fingerprint registered in the Firebase console.
# Both populated IDs must end exactly in .apps.googleusercontent.com. Do not
# use a Firebase App ID (1:...:web:...) or append an inline comment.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Deployed API origin. Required for native builds because they cannot use the
# web build's same-origin /api fallback.
# e.g. https://timber-preview.adam-montgomery.ca
EXPO_PUBLIC_API_BASE_URL=

# Opts a non-dev build into App Check's debug provider instead of Play
# Integrity / App Attest. Needed for any sideloaded build (`eas build --local`,
# adb install) since those never pass real device attestation. Leave unset for
# a Play Store / TestFlight build. The value must be registered in Firebase
# console under App Check > the app > Manage debug tokens.
EXPO_PUBLIC_APP_CHECK_DEBUG_TOKEN=
