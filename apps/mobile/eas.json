{
  "cli": {
    "version": ">= 18.0.5",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "bun": "1.3.14",
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview",
      "bun": "1.3.14",
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_APP_CHECK_DEBUG_TOKEN": "135ec249-a5ca-4d4e-b0e9-b06477255031"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "bun": "1.3.14",
      "env": {
        "APP_VARIANT": "production"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
