# =============================================================================
# @timber/mobile — Vercel web project environment
# =============================================================================
# These EXPO_PUBLIC_* values are inlined into the web JavaScript bundle and are
# readable by anyone visiting the site. Never put a secret here — the API's
# server-only values live in apps/api/.env.example.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Required. The API is its own Vercel project, so it has its own origin and the
# old same-origin `/api/*` fallback no longer applies. Whatever origin you set
# here must also appear in the API project's API_ALLOWED_ORIGINS, or the
# browser's preflight is rejected.
EXPO_PUBLIC_API_BASE_URL=
