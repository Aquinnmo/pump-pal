# Copy to wear/keystore.properties (untracked) and fill in.
# Get the keystore with: eas credentials -p android  ->  select the build profile
# whose applicationId matches the flavor you are building, then download it.
# The watch app MUST be signed with the same key as the phone app or the Data Layer
# silently refuses to connect the two.
storeFile=keystore/timber.jks
storePassword=
keyAlias=
keyPassword=
