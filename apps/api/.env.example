# =============================================================================
# @timber/api — Cloudflare Worker environment (server-only)
# =============================================================================
# Every value here is server-only. None is prefixed EXPO_PUBLIC_, and none may
# be: that prefix is what Metro inlines into the client bundle. This package is
# deployed as its own Worker, so these live in Worker secrets/variables, not
# in the web bundle. See .dev.vars.example for the local Worker shape.

# Required. AI_PROVIDER must be google or openai, and AI_MODEL must be the model
# name supported by that provider.
AI_PROVIDER=openai
AI_MODEL=gpt-5.6-luna

# Optional. One of: provider-default, none, minimal, low, medium, high, xhigh,
# max. 'max' is OpenAI-only. Leave unset for the provider default.
AI_REASONING_EFFORT=medium

# Set only the key for the selected provider.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Comma-separated allowlist of browser origins permitted to call the API.
# Required for browser Worker calls: without the web origin listed here, every
# browser call is rejected before it reaches a
# handler. Native requests have no Origin header and are not CORS-checked.
API_ALLOWED_ORIGINS=

# Firebase service account used by the API to verify tokens and access Firestore.
# Copy the private_key with its literal \n escapes intact.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
