# =============================================================================
# VERCEL — web bundle and API project environment
# =============================================================================

# --- Web bundle: public values -----------------------------------------------
# These EXPO_PUBLIC_* values are inlined into the web JavaScript bundle and
# are readable by anyone visiting the site. Never put a secret here.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Leave blank when the web bundle and /api functions are deployed to the same
# Vercel project. Set it only when the API has a separate public origin.
EXPO_PUBLIC_API_BASE_URL=

# --- API functions: server-only values ---------------------------------------
# Set these in the Vercel dashboard for the relevant environment. They are
# deliberately not prefixed EXPO_PUBLIC_; otherwise Metro would bake them into
# the client bundle.

# Required. AI_PROVIDER must be google or openai, and AI_MODEL must be the model
# name supported by that provider.
AI_PROVIDER=
AI_MODEL=

# Optional. One of: provider-default, none, minimal, low, medium, high, xhigh,
# max. 'max' is OpenAI-only. Leave unset for the provider default.
AI_REASONING_EFFORT=

# Set only the key for the selected provider.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Comma-separated allowlist of browser origins permitted to call the API.
# Native requests have no Origin header and are not CORS-checked.
API_ALLOWED_ORIGINS=

# Firebase service account used by the API to verify tokens and access Firestore.
# Copy the private_key with its literal \n escapes intact.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
