rules_version = '2';

// Security rules for Firebase project pumppal-c9199.
//
// Deploy with: npx firebase-tools@latest deploy --only firestore:rules
//
// Note: the /api/ai serverless function reaches Firestore over the REST API
// with a service-account credential, which bypasses these rules by design.
// That is what lets the server write `users/{uid}.aiUsage` and `random/{date}`
// while clients cannot.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Per-user profile: split, injuries, aiUsage.
    //
    // `aiUsage` is the server-enforced AI quota counter. Clients must not be
    // able to reset or inflate it, so writes that touch that field are denied
    // even for the document's owner.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && !('aiUsage' in request.resource.data);
      allow update: if isOwner(uid)
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['aiUsage']);
      allow delete: if isOwner(uid);

      // Pushup-challenge progress and the legacy pre-migration workouts
      // subcollection. Both are private to the owner.
      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // Canonical workout history. Ownership is carried by the `userId` field.
    match /workouts/{workoutId} {
      allow read, update, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
    }

    // Global exercise catalog and its cache-invalidation marker. Read-only to
    // the app; only the migration/seed scripts write these, and those run with
    // owner credentials that bypass rules.
    match /exercises/{exerciseId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /exerciseCatalogMeta/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Shared daily name for the pushup challenge. Generated and cached by
    // /api/ai, so no client ever needs to write it.
    match /random/{dateKey} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Anything not matched above is denied. This is load-bearing for the
    // social graph: `friendships/{pairId}` (docs/data-model/buddies.md) is
    // deliberately absent from this file. A buddy list has to read other
    // users' names and streaks, which no client-side rule can safely allow,
    // so all of it goes through /api/buddies on the service-account
    // credential. Adding a client rule for `friendships` would open
    // cross-user reads, not enable a feature.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
