rules_version = '2';

// Direct clients use only the owner-safe paths below. Service-account calls
// from the privileged Worker bypass these rules and own cross-user, secret,
// quota, username, and account-deletion operations.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function bounded() { return request.query.limit != null && request.query.limit > 0 && request.query.limit <= 200; }

    function validSplit(split) {
      return split is map
        && split.keys().hasOnly(['type', 'custom', 'updatedAt'])
        && split.type in ['Push / Pull / Legs', 'Upper / Lower', 'Bro Split', 'Full Body', 'Other']
        && (split.custom == null || (split.custom is string && split.custom.size() <= 200))
        && split.updatedAt is timestamp;
    }

    function validInjury(injury, injuryId) {
      return injury.keys().hasAll(['id', 'bodyPart', 'severity', 'status', 'onsetDate', 'createdAt', 'updatedAt'])
        && injury.keys().hasOnly(['id', 'bodyPart', 'side', 'muscles', 'severity', 'status', 'onsetDate', 'resolvedDate', 'avoid', 'notes', 'createdAt', 'updatedAt'])
        && injury.id == injuryId
        && injury.id is string
        && injury.bodyPart in ['neck', 'shoulder', 'elbow', 'wrist', 'hand', 'upper back', 'lower back', 'chest', 'abdomen', 'hip', 'groin', 'knee', 'ankle', 'foot']
        && injury.severity in ['mild', 'moderate', 'severe']
        && injury.status in ['ongoing', 'resolved']
        && injury.onsetDate is timestamp
        && injury.createdAt is timestamp
        && injury.updatedAt is timestamp
        && (!('side' in injury) || injury.side in ['left', 'right', 'both'])
        && (!('muscles' in injury) || (injury.muscles is list && injury.muscles.size() <= 40))
        && (!('avoid' in injury) || (injury.avoid is list && injury.avoid.size() <= 40))
        && (!('notes' in injury) || (injury.notes is string && injury.notes.size() <= 2000));
    }

    function validWorkout(workout, uid) {
      return workout.keys().hasAll(['userId', 'name', 'performedExercises', 'schemaVersion', 'createdAt', 'updatedAt'])
        && workout.keys().hasOnly(['userId', 'name', 'date', 'status', 'startedAt', 'queueOrder', 'notes', 'performedExercises', 'injuries', 'schemaVersion', 'createdAt', 'updatedAt'])
        && workout.userId == uid
        && workout.name is string && workout.name.size() <= 200
        && workout.performedExercises is list && workout.performedExercises.size() <= 100
        && workout.schemaVersion == 2
        && workout.createdAt is timestamp && workout.updatedAt is timestamp
        && (!('status' in workout) || workout.status in ['planned', 'in_progress', 'completed'])
        && (!('notes' in workout) || (workout.notes is string && workout.notes.size() <= 2000))
        && (!('injuries' in workout) || (workout.injuries is list && workout.injuries.size() <= 100));
    }

    function validChallenge(challenge) {
      return challenge.keys().hasOnly(['startDate', 'days', 'longestStreak'])
        && challenge.startDate is string
        && challenge.days is list && challenge.days.size() <= 400
        && challenge.longestStreak is int && challenge.longestStreak >= 0;
    }

    function validNotification(notification) {
      return notification.keys().hasOnly(['expoPushToken', 'updatedAt'])
        && notification.expoPushToken is string && notification.expoPushToken.size() <= 200
        && notification.updatedAt is timestamp;
    }

    // Owner-writable fields are optional on any given write, so each is
    // validated only when the document actually carries it — a doc that sets
    // aiEnabled alone has no workoutSplit for validSplit to inspect.
    function validUserFields(data) {
      return (!('workoutSplit' in data) || validSplit(data.workoutSplit))
        && (!('aiEnabled' in data) || data.aiEnabled is bool)
        && (!('socialEnabled' in data) || data.socialEnabled is bool);
    }

    // Direct clients can own their workout split, AI opt-in, and social preference. Username,
    // legacy injuries, quota, and push token fields are intentionally not writable.
    match /users/{uid} {
      allow get: if owner(uid);
      allow list: if false;
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['workoutSplit', 'aiEnabled', 'socialEnabled'])
        && validUserFields(request.resource.data);
      allow update: if owner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['workoutSplit', 'aiEnabled', 'socialEnabled'])
        && validUserFields(request.resource.data);
      allow delete: if false;
    }

    match /users/{uid}/injuries/{injuryId} {
      allow get: if owner(uid);
      allow list: if owner(uid) && bounded();
      allow create: if owner(uid) && validInjury(request.resource.data, injuryId);
      allow update: if owner(uid)
        && validInjury(request.resource.data, injuryId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if owner(uid);
    }

    match /users/{uid}/pushup-challenge/data {
      allow get: if owner(uid);
      allow create, update: if owner(uid) && validChallenge(request.resource.data);
      allow delete: if owner(uid);
    }

    match /users/{uid}/private/aiUsage {
      allow get: if owner(uid);
      allow list, create, update, delete: if false;
    }

    match /users/{uid}/private/notifications {
      allow create, update: if owner(uid) && validNotification(request.resource.data);
      allow delete: if owner(uid);
      allow get, list: if false;
    }

    match /workouts/{workoutId} {
      allow get: if signedIn() && resource.data.userId == request.auth.uid;
      // Rules are not filters: this condition makes Firestore require a query
      // constrained to userId == request.auth.uid, and the limit caps scans.
      allow list: if signedIn() && bounded() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && validWorkout(request.resource.data, request.auth.uid);
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && validWorkout(request.resource.data, request.auth.uid);
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /exercises/{exerciseId} {
      allow get, list: if signedIn() && resource.data.status == 'approved';
      allow create, update, delete: if false;
    }
    match /exerciseCatalogMeta/current { allow get: if signedIn(); }
    match /random/{dateKey} { allow get: if signedIn(); }

    // Explicitly deny Worker-only collections and every unknown/legacy path.
    match /{document=**} { allow read, write: if false; }
  }
}
