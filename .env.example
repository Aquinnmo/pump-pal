# =============================================================================
# CLIENT (.env) — every EXPO_PUBLIC_* value here is inlined into the JS bundle
# by Metro and is readable by anyone with the APK or the web build. Never put a
# secret in this file.
# =============================================================================

# Firebase — copy this file to .env and fill in your values.
# Firebase web config is public by design; it is protected by firestore.rules,
# not by being hidden.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Base URL of the deployed /api/ai proxy, used by native builds only (the web
# build is served from the same origin and uses a relative path). Not a secret.
# e.g. https://pump-pal.vercel.app
EXPO_PUBLIC_API_BASE_URL=

# =============================================================================
# SERVER (Vercel project environment variables) — set these in the Vercel
# dashboard for Production and Preview. They are NOT prefixed EXPO_PUBLIC_ and
# must never be, or Metro will bake them into the client bundle.
# =============================================================================

# AI provider configuration. AI_PROVIDER and AI_MODEL are REQUIRED — there is
# no silent default; an unset or unsupported combination fails at cold start.
# AI_PROVIDER=google
# AI_MODEL=gemini-3.5-flash
# For OpenAI instead:
# AI_PROVIDER=openai
# AI_MODEL=gpt-5.6-luna

# Optional. One of: provider-default, none, minimal, low, medium, high,
# xhigh, max. Defaults to provider-default (no reasoning option is set).
# 'max' is OpenAI-only; requesting it with AI_PROVIDER=google fails at cold
# start rather than silently clamping to 'high'.
# AI_REASONING_EFFORT=provider-default

# Provider API key — server-only. Only the SELECTED provider's key is read;
# the other is never required.
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Comma-separated allowlist of origins permitted to call the domain API
# cross-origin (Preview/Production web app origins). Requests with no Origin
# header (native app) are never CORS-checked. api/_lib/http.ts.
# API_ALLOWED_ORIGINS=https://timber-preview.adam-montgomery.ca,https://timber-api.adam-montgomery.ca

# Firebase service account, used to verify ID tokens and write the AI quota.
# From Firebase console → Project settings → Service accounts → Generate key.
# Paste the private key with its literal \n escapes intact.
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
