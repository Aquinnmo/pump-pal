{
  "name": "pump-pal",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:setup": "bash scripts/ios/setup.sh",
    "ios:update": "bash scripts/ios/update.sh",
    "install:apple": "bash scripts/ios/update.sh",
    "web": "expo start --web",
    "lint": "expo lint",
    "generate:icons": "node scripts/generate-icons.js",
    "generate:muscle-map": "node scripts/generate-muscle-pebble-map.js",
    "build:web": "npx expo export -p web",
    "test:ios-scripts": "bash scripts/ios/_common.sh --self-test",
    "test:ai-quota": "tsx api/_lib/store/quota.test.ts",
    "test:api-isolation": "node scripts/check-api-isolation.js",
    "test:up-next": "tsx utils/up-next.test.ts",
    "test:wear-state": "tsx utils/wear-state.test.ts",
    "test:workout-notification": "tsx utils/workout-notification-model.test.ts",
    "test:workout-action": "tsx utils/workout-action.test.ts",
    "test:muscle-load": "tsx utils/muscle-load.test.ts && tsx utils/muscle-development.test.ts && node scripts/generate-muscle-pebble-map.test.js && tsx constants/muscle-map-paths.test.ts",
    "migration:test": "node scripts/migration/convert-legacy-workout.test.js && node scripts/migration/legacy-inventory.test.js && node scripts/migration/canonical-muscles.test.js && node scripts/migration/catalog-seed.test.js && node scripts/migration/review-pending-exercises.test.js",
    "migration:inventory": "node scripts/migration/legacy-inventory.js",
    "migration:firestore:snapshot": "node scripts/migration/firestore-readonly-snapshot.js",
    "migration:seed:exercises": "node scripts/migration/seed-exercise-catalog.js",
    "migration:review:exercises": "node scripts/migration/review-pending-exercises.js",
    "migration:mapping:draft": "node scripts/migration/generate-mapping-draft.js",
    "migration:mapping:validate": "node scripts/migration/validate-mapping.js",
    "migration:dry-run": "node scripts/migration/dry-run-conversion.js",
    "migration:write:workouts": "node scripts/migration/write-migrated-workouts.js",
    "development:android": "APP_VARIANT=development npx expo prebuild --clean --platform android && APP_VARIANT=development npx expo run:android;",
    "freshDevelopment:android": "adb uninstall com.aquinnmo.timber.dev; npm run development:android",
    "install:android": "npx expo prebuild --clean --platform android && npx expo run:android --variant release"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.12",
    "@ai-sdk/openai": "^4.0.27",
    "@expo/vector-icons": "^15.0.3",
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "ai": "^7.0.22",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-insights": "~0.10.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-localization": "~17.0.9",
    "expo-navigation-bar": "~5.0.10",
    "expo-router": "~6.0.23",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.16",
    "expo-web-browser": "~15.0.11",
    "firebase": "^12.9.0",
    "jose": "^6.2.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-android-widget": "^0.21.0",
    "react-native-chart-kit": "^6.12.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-reorderable-list": "^0.18.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "@vercel/node": "^5.9.5",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "sharp": "^0.35.3",
    "tsx": "^4.23.4",
    "typescript": "~5.9.2"
  },
  "private": true
}
