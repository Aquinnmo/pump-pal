{
  "name": "pump-pal",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm -w @timber/mobile run start",
    "android": "npm -w @timber/mobile run android",
    "ios": "npm -w @timber/mobile run ios",
    "web": "npm -w @timber/mobile run web",
    "lint": "npm -w @timber/mobile run lint",
    "build:web": "npm -w @timber/mobile run build:web",
    "install:apple": "npm -w @timber/mobile run install:apple",
    "dev:android": "npm -w @timber/mobile run dev:android",
    "install:android": "npm -w @timber/mobile run install:android",
    "test": "npm run -s test:contract && npm run -s test:api && npm run -s test:mobile && npm run -s test:tools",
    "typecheck": "npm -w @timber/contract run -s typecheck && npm -w @timber/api run -s typecheck && npm -w @timber/mobile run -s typecheck",
    "test:contract": "npm -w @timber/contract run -s test",
    "test:api": "npm -w @timber/api run -s test",
    "test:mobile": "npm -w @timber/mobile run -s test",
    "test:tools": "npm run -s test:boundary-isolation && npm run -s test:web-native-deps && npm run -s test:catalog-tools",
    "test:boundary-isolation": "node tools/check-boundary-isolation.js",
    "test:web-native-deps": "node tools/check-web-native-deps.js",
    "test:catalog-tools": "node tools/catalog/canonical-muscles.test.js && node tools/catalog/catalog-seed.test.js && node tools/catalog/review-pending-exercises.test.js",
    "generate:icons": "node tools/generate-icons.js",
    "generate:muscle-map": "node tools/generate-muscle-pebble-map.js",
    "catalog:seed": "node tools/catalog/seed-exercise-catalog.js",
    "catalog:review": "node tools/catalog/review-pending-exercises.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "sharp": "^0.35.3",
    "tsx": "^4.23.4",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.8.13",
    "path-to-regexp": "^6.3.0",
    "js-yaml": "^4.3.1",
    "minimatch": "^10.2.3",
    "undici": "^6.28.0"
  }
}
