{
  "name": "pump-pal",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "install:apple": "git switch main && git pull && npm install && npx expo run:ios --device --configuration Release",
    "web": "expo start --web",
    "lint": "expo lint",
    "generate:icons": "node scripts/generate-icons.js",
    "generate:muscle-map": "node scripts/generate-muscle-pebble-map.js",
    "build:web": "npx expo export -p web",
    "test:ios-scripts": "bash scripts/ios/_common.sh --self-test",
    "test:personal-ios-config": "node app.config.test.js",
    "test:ai-quota": "tsx api/_lib/store/quota.test.ts",
    "test:api-contract": "tsx shared/api-contract.test.ts",
    "test:api-http": "tsx api/_lib/http.test.ts",
    "test:api-router": "tsx api/_lib/router.test.ts",
    "test:ai-model": "tsx api/_lib/ai/model.test.ts",
    "test:api-rest": "tsx api/_lib/store/rest.test.ts",
    "test:api-rest-integration": "tsx api/_lib/store/rest.integration.test.ts",
    "test:api-workouts": "tsx api/_lib/store/workouts.test.ts",
    "test:api-injuries": "tsx api/_lib/store/injuries.test.ts",
    "test:api-account": "tsx api/_lib/store/account.test.ts",
    "test:api-buddies": "tsx api/_lib/store/buddies.test.ts",
    "test:api-catalog": "tsx api/_lib/store/catalog.test.ts",
    "test:api-pushup": "tsx api/_lib/store/pushup-challenge.test.ts",
    "test:api-sync": "tsx api/_lib/store/sync.test.ts",
    "test:api": "npm run -s test:api-isolation && npm run -s test:boundary-isolation && npm run -s test:api-contract && npm run -s test:api-http && npm run -s test:api-router && npm run -s test:ai-model && npm run -s test:ai-quota && npm run -s test:api-rest && npm run -s test:api-rest-integration && npm run -s test:api-workouts && npm run -s test:api-injuries && npm run -s test:api-account && npm run -s test:api-buddies && npm run -s test:api-catalog && npm run -s test:api-pushup && npm run -s test:api-sync",
    "test:ai-error": "tsx utils/format-ai-error.test.ts",
    "test:api-isolation": "node scripts/check-api-isolation.js",
    "test:boundary-isolation": "node scripts/check-boundary-isolation.js",
    "test:db": "tsx db/migrate.test.ts && tsx db/outbox.test.ts && tsx db/sync-cursors.test.ts && tsx db/normalize-timestamps.test.ts && tsx db/singleton-repository.test.ts && tsx db/catalog.test.ts && tsx db/workouts.test.ts && tsx db/data-version.test.ts && tsx db/sync-engine.test.ts && tsx db/keyed-mutex.test.ts",
    "test:initial-sync": "tsx db/initial-sync.test.ts",
    "test:api-client": "tsx utils/api-client.test.ts",
    "test:oauth-config": "node config/google-oauth.test.js",
    "test:google-account-link": "tsx utils/google-account-link.test.ts",
    "test:firebase-errors": "tsx utils/firebase-errors.test.ts",
    "test:workout-conversion": "tsx utils/workout-conversion.test.ts",
    "test:web-native-deps": "node scripts/check-web-native-deps.js",
    "test:up-next": "tsx utils/up-next.test.ts",
    "test:wear-state": "tsx utils/wear-state.test.ts",
    "test:workout-notification": "tsx utils/workout-notification-model.test.ts",
    "test:workout-action": "tsx utils/workout-action.test.ts",
    "test:active-workout-session": "tsx utils/active-workout-session.test.ts",
    "test:set-consistency": "tsx utils/set-consistency.test.ts",
    "test:muscle-load": "tsx utils/muscle-load.test.ts && tsx utils/muscle-development.test.ts && node scripts/generate-muscle-pebble-map.test.js && tsx constants/muscle-map-paths.test.ts",
    "migration:test": "node scripts/migration/convert-legacy-workout.test.js && node scripts/migration/legacy-inventory.test.js && node scripts/migration/canonical-muscles.test.js && node scripts/migration/catalog-seed.test.js && node scripts/migration/review-pending-exercises.test.js",
    "migration:inventory": "node scripts/migration/legacy-inventory.js",
    "migration:firestore:snapshot": "node scripts/migration/firestore-readonly-snapshot.js",
    "migration:seed:exercises": "node scripts/migration/seed-exercise-catalog.js",
    "migration:review:exercises": "node scripts/migration/review-pending-exercises.js",
    "migration:mapping:draft": "node scripts/migration/generate-mapping-draft.js",
    "migration:mapping:validate": "node scripts/migration/validate-mapping.js",
    "migration:dry-run": "node scripts/migration/dry-run-conversion.js",
    "migration:write:workouts": "node scripts/migration/write-migrated-workouts.js",
    "migration:backfill:usernames": "node scripts/migration/backfill-usernames.js",
    "development:android": "APP_VARIANT=development npx expo prebuild --clean --platform android && APP_VARIANT=development npx expo run:android;",
    "freshDevelopment:android": "adb uninstall com.aquinnmo.timber_dev; npm run development:android",
    "preview:android": "eas build --platform android --profile preview --local --output ./build-preview.apk"
  },
